# Local-first AI providers.  No Groq or Gemini key is required in this mode.
ASR_PROVIDER=local
LOCAL_ASR_MODEL=large-v3
LOCAL_ASR_DEVICE=auto
LOCAL_ASR_COMPUTE_TYPE=auto # CUDA resolves to int8_float16 to preserve VRAM for the LLM
LOCAL_ASR_VAD_FILTER=true

TEXT_PROVIDER=local
# Ollama's OpenAI-compatible endpoint is used by default.  Replace this URL
# when using vLLM or another OpenAI-compatible server on your own machine.
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=qwen3:4b
LOCAL_LLM_API_KEY=
LOCAL_LLM_PROTOCOL=ollama
LOCAL_LLM_THINKING=false
TRANSLATION_BATCH_SIZE=25

# Edge is retained until a tested Vietnamese local TTS server is available.
# A local server must expose POST /v1/audio/speech and return WAV data.
TTS_PROVIDER=edge
LOCAL_TTS_BASE_URL=
LOCAL_TTS_MODEL=
LOCAL_TTS_API_KEY=

# Do not transmit media/text to cloud services unless this is explicitly true.
ALLOW_CLOUD_FALLBACK=false

# One GPU-intensive pipeline at a time is the safest default.
WORKER_CONCURRENCY=1

# Generated videos stay local by default.  Review them before enabling this.
AUTO_PUBLISH=false

# Optional compatibility providers.  Only required when the corresponding
# provider is selected or cloud fallback is intentionally enabled.
GROQ_API_KEY=
GEMINI_API_KEY=
VIVIBE_API_KEY=
FB_PAGE_ACCESS_TOKEN=

# Optional downloader cookies path.
YTDLP_COOKIES_FILE=
